[Unit]
Description=Steward quota-enforced OpenZFS storage worker
Documentation=https://github.com/hardrails/steward
After=docker.service
Requires=docker.service
ConditionPathExists=/etc/steward/storage-zfs.json
ConditionPathExists=/etc/steward/storage-zfs-worker-token
AssertSecurity=apparmor

[Service]
Type=notify
NotifyAccess=main
# This separate process holds only the host authority needed to manage the
# operator-selected ZFS subtree and its exact Docker bind volumes. The Executor
# remains an unprivileged process and reaches this worker through a protected
# Unix socket.
User=root
Group=steward-executor
UMask=0007
# Only the OS policy loader runs with full privilege. Its input is the selected
# immutable release, never tenant configuration. A failed load prevents startup.
ExecStartPre=+/usr/sbin/apparmor_parser --replace /opt/steward/current/integration/deploy/config/storage-zfs.apparmor
ExecStart=/usr/bin/aa-exec -p steward-storage-zfs -- /usr/local/bin/steward-storage-zfs -config=/etc/steward/storage-zfs.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
TimeoutStartSec=3min
RuntimeDirectory=steward-storage-zfs
RuntimeDirectoryMode=0750
StateDirectory=steward-state
StateDirectoryMode=0700

NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_CHOWN
AmbientCapabilities=CAP_SYS_ADMIN CAP_CHOWN
# A private filesystem namespace hides newly created ZFS mounts from Docker.
# Mandatory AppArmor supplies path/mount confinement in the host namespace.
PrivateTmp=no
ProtectClock=no
ProtectControlGroups=no
ProtectHome=no
ProtectHostname=yes
ProtectKernelLogs=no
ProtectKernelModules=no
ProtectKernelTunables=no
ProtectSystem=no
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
