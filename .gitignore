# Compiled binary produced by `go build ./cmd/steward`
/steward
/steward-executor

# Release build output produced by `scripts/release.sh` (cross-compiled
# archives + checksums); published to a GitHub Release, never committed.
/dist/

# Test and coverage artifacts
*.out
*.test
__pycache__/
*.pyc

# React control-console build dependencies. The audited production bundle is
# committed so normal and air-gapped Go builds never require Node or npm.
/internal/controlplane/console/node_modules/

# Terraform working directories and local state. Example dependency lock files
# remain committed so provider selection is repeatable.
.terraform/
*.tfstate
*.tfstate.*
crash.log
