#!/bin/sh
set -eu

port=
root=
while [ "$#" -gt 0 ]; do
	case "$1" in
	-f)
		shift
		;;
	-p)
		[ "$#" -ge 2 ] || exit 2
		port=$2
		shift 2
		;;
	-h)
		[ "$#" -ge 2 ] || exit 2
		root=$2
		shift 2
		;;
	*)
		exit 2
		;;
	esac
done

case "$port" in
''|*[!0-9]*) exit 2 ;;
esac
[ "$port" -ge 1 ] && [ "$port" -le 65535 ] || exit 2
[ "$root" = /state ] || exit 2

exec python3 -m http.server "$port" --bind 0.0.0.0 --directory "$root"
